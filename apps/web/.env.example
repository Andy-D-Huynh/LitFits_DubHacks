# Copy to .env.local. Everything is optional: with nothing set the app runs in
# demo-capable mode with mock providers.

# Supabase (hosted project: Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM, used for product extraction only (never sees body data or photos)
ANTHROPIC_API_KEY=
# Product normalization: anthropic | mock (mock = deterministic JSON-LD + table parsing, no network)
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-5-5

# Try-on: fal (preferred) | replicate | mock. The mock is used in demo mode and
# whenever the selected provider's key is missing.
TRYON_PROVIDER=mock
# fal.ai key, server-side only (never NEXT_PUBLIC_)
FAL_KEY=
# Endpoint/model; for fal defaults to fal-ai/fashn/tryon/v1.6. Required for replicate.
TRYON_MODEL=
# Max real-provider layer renders per profile per 24 h (cache hits are free)
TRYON_DAILY_LIMIT=20
REPLICATE_API_TOKEN=
GEMINI_API_KEY=

# Payments: visa | mock (VISA_* vars added once the sandbox is known)
PAYMENT_PROVIDER=mock

# Messaging: photon | mock
MESSAGING_PROVIDER=mock

# true forces demo mode (fixtures + precomputed renders, no network)
DEMO_MODE=false
