# Copy to .env.local. Everything is optional: with nothing set the app runs in
# demo-capable mode with mock providers.

# Supabase (hosted project: Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM, used for product extraction only (never sees body data or photos)
ANTHROPIC_API_KEY=
LLM_MODEL=

# Try-on: replicate | gemini | mock
TRYON_PROVIDER=mock
REPLICATE_API_TOKEN=
TRYON_MODEL=
GEMINI_API_KEY=

# Payments: visa | mock (VISA_* vars added once the sandbox is known)
PAYMENT_PROVIDER=mock

# Messaging: photon | mock
MESSAGING_PROVIDER=mock

# true forces demo mode (fixtures + precomputed renders, no network)
DEMO_MODE=false
